# Copiar a .env.local y completar. NUNCA subir el archivo con valores reales.

# URL base de la API. En local apunta al backend levantado con Docker o Maven.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# El mismo backend pero sin el prefijo /api/v1. La usa el aterrizaje del magic
# link (app/auth/verify). Tiene que apuntar al mismo sitio que la de arriba:
# si se cambia una, cambiar la otra.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Si se trabaja contra mocks mientras el backend no esta listo
NEXT_PUBLIC_USE_MOCKS=false
