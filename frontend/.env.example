# Copiar a .env.local y completar. NUNCA subir el archivo con valores reales.

# URL base de la API. En local apunta al backend levantado con Docker o Maven.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Si se trabaja contra mocks mientras el backend no esta listo
NEXT_PUBLIC_USE_MOCKS=false
