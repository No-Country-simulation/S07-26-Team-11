# Copiar a .env y completar con valores reales. NUNCA subir el .env al repositorio.

# Base de datos
# DB_PORT es el puerto que Docker publica en el HOST. Cambialo si el 5432 ya
# esta ocupado por otro Postgres, y ajusta DB_URL para que coincida.
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/dcplatform
DB_USER=dcplatform
DB_PASSWORD=cambiar-en-local
DB_POOL_SIZE=5

# Servidor
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Seguridad - generar uno propio, minimo 32 caracteres aleatorios
JWT_SECRET=

# Proveedor de email (brevo | resend)
EMAIL_PROVIDER=brevo
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_DAILY_QUOTA=300

# Object storage para los PDF
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Worker
PDF_WORKER_ENABLED=true
