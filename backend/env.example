# =====================================================================
#      cp .env.example .env
# =====================================================================

# ---- Base de datos (Supabase / Postgres) ----
DB_URL=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=public
DB_POOL_SIZE=5
FLYWAY_ENABLED=true
DB_STATUS_DETAILS=true
DB_PORT=5432


PORT=8080
# Lista separada por comas. Nunca "*": se envian credenciales.
CORS_ALLOWED_ORIGINS=
JWT_SECRET=

# ---- OpenAPI ----
OPENAPI_STAGING_URL=

# ---- Correo ----
EMAIL_PROVIDER=brevo
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_DAILY_QUOTA=300

# ---- Object Storage: Oracle Cloud (bucket privado) ----
# Sin estas variables la API arranca igual, pero la generacion y la descarga
# de PDF responden 503.
#
OCI_BUCKET_NAME=
# OPCIONAL:
OCI_NAMESPACE=
OCI_REGION=
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
OCI_PRIVATE_KEY_PATH=
OCI_PRIVATE_KEY_BASE64=
# Solo si la clave privada tiene passphrase.
OCI_PRIVATE_KEY_PASSPHRASE=
# Vigencia de la URL
OCI_SIGNED_URL_TTL=15m
OCI_KEY_PREFIX=benchmark-reports/

# ---- Worker - PDF ----
PDF_WORKER_ENABLED=true
# =====================================================================
